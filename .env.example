# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Sign-in needs these two as well, or /api/auth says "Auth0 isn't configured on this server".
# AUTH0_SECRET: any 64 hex characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
DATABASE_URL=

# The real phone line (Trail #70, hosting/README.md "Real phone calls"). Real numbers live only in .env.
VOICE_LLM_SECRET=
VOICE_LLM_URL=
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM_SECRET_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TEST_PATIENT_PHONE=
VOICE_LLM_DEBUG=

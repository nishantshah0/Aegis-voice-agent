# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
DATABASE_URL=

# The real phone line (Trail #70, hosting/README.md "Real phone calls"). Real numbers live only in .env.
VOICE_LLM_SECRET=
VOICE_LLM_URL=
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM_SECRET_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TEST_PATIENT_PHONE=
VOICE_LLM_DEBUG=
# Twilio trial: texts the one-time code through Twilio Verify (trials can't send free-form texts)
TWILIO_VERIFY_SERVICE_SID=
# Phone latency: AGENT_THINKING=off skips the agent's hidden reasoning (the lock holds either way);
# VOICE_FILLER_MS is how long a turn may think before the caller hears "One moment." (default 1200)
AGENT_THINKING=
VOICE_FILLER_MS=
